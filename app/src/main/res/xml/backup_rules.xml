<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Preferences contain device-bound encrypted credentials; users can use ArchiveTune's
         explicit backup/export flow for data they intentionally choose to move. -->
    <exclude
        domain="file"
        path="datastore/settings.preferences_pb" />
    <exclude
        domain="file"
        path="./exoplayer" />
    <exclude
        domain="file"
        path="./download" />
    <exclude
        domain="database"
        path="exoplayer_internal.db" />
</full-backup-content>
